{
  "name": "dsh-agentnoodle",
  "version": "0.1.14",
  "description": "可扩展的 AI 群像聊天游戏框架（DeepSeek Harness 插件）：输入一个行动，多个 NPC 各自回应，带头像插图；世界、地点、NPC 与功能扩展都可在对话里让 agent 直接添加修改，无需写代码。",
  "type": "module",
  "main": "lib/index.js",
  "scripts": {
    "test": "node scripts/selftest.mjs",
    "check": "node --check lib/index.js && node --check lib/game.js && node --check client/client.js && node scripts/selftest.mjs"
  },
  "license": "MIT",
  "keywords": [
    "dsh",
    "dsh-plugin",
    "deepseek",
    "harness",
    "game",
    "rpg",
    "narrative",
    "ai",
    "chat",
    "tavern"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/bigharm/dsh-agentnoodle.git"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web"
    }
  },
  "exports": {
    ".": {
      "default": "./lib/index.js"
    },
    "./client": "./client/client.js",
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./package.json": "./package.json"
  },
  "files": [
    "lib",
    "client",
    "seed",
    "cordis.patch.yml",
    "README.md",
    "LICENSE"
  ],
  "publishConfig": {
    "registry": "https://registry.npmjs.org/"
  }
}
